                        <input id="arquivoBackup" type="file" accept=".json" hidden onchange="importarDados(this.files[0]); this.value='';">
                        <button class="btn btn-secondary" style="grid-column:2; justify-self:start;" type="button" onclick="document.getElementById('arquivoBackup').click()">Restaurar backup</button>
                    </div>

                    <div class="setting-card setting-danger">
                        <div class="setting-icon">⚠️</div>
                        <div>
                            <h4>Apagar Dados Locais</h4>
