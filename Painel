</div>

<script>
    /* DADOS E INICIALIZAÇÃO */
    const PRODUTOS_PADRAO = [
        { id: "p1", nome: "COMBO SOFRÊNCIA", categoria: "Combos", preco: 15.00, descricao: "250g batata frita + 250g mini salgados + calabresa", disponivel: true, destaque: true, imagem: "" },
        { id: "p2", nome: "COMBO PEGAÇÃO", categoria: "Combos", preco: 27.00, descricao: "250g batata frita + mini salgados + calabresa + pastelitos", disponivel: true, destaque: true, imagem: "" },
        { id: "p3", nome: "COMBO FAMÍLIA", categoria: "Combos", preco: 45.00, descricao: "400g batata frita + 400g salgados + calabresa acebolada", disponivel: true, destaque: true, imagem: "" },
        { id: "p4", nome: "Bolo de Pote Ninho", categoria: "Sobremesas", preco: 3.50, descricao: "Bolo artesanal recheado com leite ninho.", disponivel: true, destaque: false, imagem: "" },
        { id: "p5", nome: "Refrigerante Lata", categoria: "Bebidas", preco: 5.00, descricao: "Lata 350ml gelada.", disponivel: true, destaque: false, imagem: "" }
    ];

    let produtosPainel = JSON.parse(localStorage.getItem("hubProdutos")) || PRODUTOS_PADRAO;
    let produtosLojaFisica = JSON.parse(localStorage.getItem("hubProdutosLoja")) || [
        { id: "pl1", nome: "COMBO DO DIA", categoria: "Promoções", preco: 19.90, descricao: "Sorvete artesanal duplo + cascata extra", disponivel: true, destaque: true, imagem: "" },
        { id: "pl2", nome: "COMBO FAMÍLIA", categoria: "Combos", preco: 39.90, descricao: "Pote especial 1L + 4 casquinhas recheadas", disponivel: true, destaque: true, imagem: "" },
        { id: "pl3", nome: "Sorvete Artesanal Copo", categoria: "Sorvetes", preco: 12.00, descricao: "2 bolas com cobertura", disponivel: true, destaque: false, imagem: "" }
    ];

    let novaImagemProduto = "";
    let produtoEditando = null;
    let contextoEdicao = "online"; // 'online' ou 'loja'

    /* NAVEGAÇÃO ENTRE ABAS */
    const botoesMenu = document.querySelectorAll(".menu-btn");
    const secoes = document.querySelectorAll(".section");
    const tituloPagina = document.getElementById("pageTitle");

    botoesMenu.forEach(btn => {
        btn.addEventListener("click", () => {
            botoesMenu.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");

            secoes.forEach(s => s.classList.remove("active"));
            const targetId = btn.dataset.section;
            document.getElementById(targetId).classList.add("active");

            tituloPagina.textContent = btn.textContent.trim();

            if (targetId === "produtos") renderizarProdutos();
            if (targetId === "cardapioLoja") carregarModuloCardapioLoja();
            if (targetId === "categorias") renderizarCategorias();
            if (targetId === "dashboard") atualizarDashboard();
            if (targetId === "cardapioImpresso") carregarConfigImpresso();
            if (targetId === "aparencia") carregarAparencia();
            if (targetId === "configuracoes") atualizarResumoConfiguracoes();
        });
    });

    function formatarPreco(val) {
        return Number(val || 0).toFixed(2).replace(".", ",");
    }

    /* GESTÃO DE PRODUTOS ONLINE */
    function renderizarProdutos() {
        const lista = document.getElementById("listaProdutos");
        const busca = document.getElementById("buscaProduto").value.toLowerCase().trim();
        lista.innerHTML = "";

        const filtrados = produtosPainel.filter(p => 
            (p.nome + " " + p.categoria + " " + (p.descricao || "")).toLowerCase().includes(busca)
        );

        if (filtrados.length === 0) {
            lista.innerHTML = `<div class="notice">Nenhum produto cadastrado ou encontrado na busca.</div>`;
            return;
        }

        filtrados.forEach(produto => {
            const indexOriginal = produtosPainel.findIndex(p => p.id === produto.id);
            const item = document.createElement("div");
            item.className = "product";

            item.innerHTML = `
                <div class="product-info">
                    ${produto.imagem ? `<img class="product-image" src="${produto.imagem}" alt="${produto.nome}">` : `<div class="product-image" style="display:grid;place-items:center;color:#9ca3af;font-size:24px;">🍽️</div>`}
                    <div>
                        <h4>${produto.nome}</h4>
                        <p>${produto.categoria} • ${produto.descricao || "Sem descrição"}</p>
                        <div class="product-price">R$ ${formatarPreco(produto.preco)}</div>
                        <div class="badges">
                            <span class="badge ${produto.disponivel !== false ? 'badge-active' : 'badge-inactive'}">
                                ${produto.disponivel !== false ? 'Disponível' : 'Indisponível'}
                            </span>
                            ${produto.destaque ? '<span class="badge badge-highlight">⭐ Destaque</span>' : ''}
                        </div>
                    </div>
                </div>
                <div class="product-actions">
                    <button class="btn btn-whatsapp" onclick="enviarProdutoIndividual(${indexOriginal})" title="Enviar este item no WhatsApp">
                        Enviar no Whats
                    </button>
                    <button class="btn btn-secondary" onclick="editarProduto(${indexOriginal}, 'online')">Editar</button>
                    <button class="btn ${produto.disponivel !== false ? 'btn-danger' : 'btn-success'}" onclick="alternarDisponibilidade(${indexOriginal}, 'online')">
                        ${produto.disponivel !== false ? 'Pausar' : 'Ativar'}
                    </button>
                    <button class="btn btn-danger" onclick="excluirProduto(${indexOriginal}, 'online')">Excluir</button>
                </div>
            `;
            lista.appendChild(item);
        });
    }

    /* GESTÃO DO MÓDULO CARDÁPIO LOJA FÍSICA */
    function carregarModuloCardapioLoja() {
        const whats = localStorage.getItem("hubTelefoneCozinha") || "21977138992";
        document.getElementById("whatsCozinhaInput").value = whats;
        gerarQrCodeLojaFisica();
        renderizarProdutosLojaFisica();
    }

    function salvarWhatsCozinha() {
        const val = document.getElementById("whatsCozinhaInput").value.trim().replace(/\D/g, '');
        if (!val) { alert("Digite um telefone válido."); return; }
        localStorage.setItem("hubTelefoneCozinha", val);
        alert("Telefone do balcão/cozinha salvo com sucesso!");
    }

    function obterUrlLojaFisica() {
        let base = window.location.href.substring(0, window.location.href.lastIndexOf('/') + 1);
        return base + "loja.html";
    }

    function gerarQrCodeLojaFisica() {
        const url = obterUrlLojaFisica();
        document.getElementById("qrCodeLojaPreview").src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(url)}`;
        document.getElementById("btnAbrirLojaNovaAba").href = url;
    }

    function copiarLinkLojaFisica() {
        navigator.clipboard.writeText(obterUrlLojaFisica()).then(() => alert("Link do Cardápio da Loja copiado!"));
    }

    function renderizarProdutosLojaFisica() {
        const lista = document.getElementById("listaProdutosLoja");
        lista.innerHTML = "";

        if (produtosLojaFisica.length === 0) {
            lista.innerHTML = `<div class="notice">Nenhum produto exclusivo cadastrado para a loja física. Os clientes verão os produtos gerais ou você pode cadastrar promoções acima.</div>`;
            return;
        }

        produtosLojaFisica.forEach((produto, index) => {
            const item = document.createElement("div");
            item.className = "product";

            item.innerHTML = `
                <div class="product-info">
                    ${produto.imagem ? `<img class="product-image" src="${produto.imagem}" alt="${produto.nome}">` : `<div class="product-image" style="display:grid;place-items:center;color:#9ca3af;font-size:24px;">🍦</div>`}
                    <div>
                        <h4>${produto.nome}</h4>
                        <p>${produto.categoria} • ${produto.descricao || "Sem descrição"}</p>
                        <div class="product-price">R$ ${formatarPreco(produto.preco)}</div>
                        <div class="badges">
                            <span class="badge badge-local">🏪 Exclusivo Loja</span>
                            <span class="badge ${produto.disponivel !== false ? 'badge-active' : 'badge-inactive'}">
                                ${produto.disponivel !== false ? 'Disponível' : 'Indisponível'}
                            </span>
                            ${produto.destaque ? '<span class="badge badge-highlight">⭐ Destaque</span>' : ''}
                        </div>
                    </div>
                </div>
                <div class="product-actions">
                    <button class="btn btn-secondary" onclick="editarProduto(${index}, 'loja')">Editar</button>
                    <button class="btn ${produto.disponivel !== false ? 'btn-danger' : 'btn-success'}" onclick="alternarDisponibilidade(${index}, 'loja')">
                        ${produto.disponivel !== false ? 'Pausar' : 'Ativar'}
                    </button>
                    <button class="btn btn-danger" onclick="excluirProduto(${index}, 'loja')">Excluir</button>
                </div>
            `;
            lista.appendChild(item);
        });
    }

    function importarProdutosParaLoja() {
        if (confirm("Deseja copiar todos os produtos online para a lista da loja física? Você poderá editá-los individualmente depois.")) {
            produtosLojaFisica = JSON.parse(JSON.stringify(produtosPainel));
            localStorage.setItem("hubProdutosLoja", JSON.stringify(produtosLojaFisica));
            renderizarProdutosLojaFisica();
            atualizarDashboard();
            alert("Produtos copiados para a loja física!");
        }
    }

    function abrirNovoProduto() {
        contextoEdicao = "online";
        abrirModalFormulario("Novo Produto Online");
    }

    function abrirNovoProdutoLoja() {
        contextoEdicao = "loja";
        abrirModalFormulario("Novo Produto / Combo da Loja Física");
    }

    function abrirModalFormulario(titulo) {
        produtoEditando = null;
        document.getElementById("modalTitulo").textContent = titulo;
        document.getElementById("produtoNome").value = "";
        document.getElementById("produtoCategoria").value = "";
        document.getElementById("produtoPreco").value = "";
        document.getElementById("produtoImagem").value = "";
        document.getElementById("produtoDescricao").value = "";
        document.getElementById("produtoDisponivel").value = "true";
        document.getElementById("produtoDestaque").value = "false";
        limparPreviaFoto();
        document.getElementById("modalProduto").classList.add("active");
    }

    function editarProduto(index, tipo) {
        contextoEdicao = tipo;
        produtoEditando = index;
        const arrayAlvo = tipo === "loja" ? produtosLojaFisica : produtosPainel;
        const p = arrayAlvo[index];

        document.getElementById("modalTitulo").textContent = tipo === "loja" ? "Editar Produto Loja Física" : "Editar Produto Online";
        document.getElementById("produtoNome").value = p.nome;
        document.getElementById("produtoCategoria").value = p.categoria;
        document.getElementById("produtoPreco").value = p.preco;
        document.getElementById("produtoImagem").value = p.imagem && !p.imagem.startsWith("data:") ? p.imagem : "";
        document.getElementById("produtoDescricao").value = p.descricao || "";
        document.getElementById("produtoDisponivel").value = String(p.disponivel !== false);
        document.getElementById("produtoDestaque").value = String(p.destaque === true);
        
        limparPreviaFoto();
        if (p.imagem) {
            const preview = document.getElementById("produtoImagemPreview");
            preview.src = p.imagem;
            preview.style.display = "block";
        }
        document.getElementById("modalProduto").classList.add("active");
    }

    function salvarProdutoGenerico() {
        const nome = document.getElementById("produtoNome").value.trim();
        const categoria = document.getElementById("produtoCategoria").value.trim();
        const preco = parseFloat(document.getElementById("produtoPreco").value);
        const imgUrl = document.getElementById("produtoImagem").value.trim();
        const imagemFinal = novaImagemProduto || imgUrl;
        const descricao = document.getElementById("produtoDescricao").value.trim();
        const disponivel = document.getElementById("produtoDisponivel").value === "true";
        const destaque = document.getElementById("produtoDestaque").value === "true";

        if (!nome || isNaN(preco)) {
            alert("Preencha o nome e um preço válido.");
            return;
        }

        const arrayAlvo = contextoEdicao === "loja" ? produtosLojaFisica : produtosPainel;

        if (produtoEditando === null) {
            arrayAlvo.push({
                id: (contextoEdicao === "loja" ? "prod-loja-" : "prod-") + Date.now(),
                nome, categoria: categoria || "Geral", preco, imagem: imagemFinal, descricao, disponivel, destaque
            });
        } else {
            arrayAlvo[produtoEditando] = {
                ...arrayAlvo[produtoEditando],
                nome, categoria: categoria || "Geral", preco, imagem: imagemFinal, descricao, disponivel, destaque
            };
        }

        if (contextoEdicao === "loja") {
            localStorage.setItem("hubProdutosLoja", JSON.stringify(produtosLojaFisica));
            renderizarProdutosLojaFisica();
        } else {
            localStorage.setItem("hubProdutos", JSON.stringify(produtosPainel));
            renderizarProdutos();
        }

        fecharModal();
        atualizarDashboard();
    }

    function alternarDisponibilidade(index, tipo) {
        const arrayAlvo = tipo === "loja" ? produtosLojaFisica : produtosPainel;
        arrayAlvo[index].disponivel = !(arrayAlvo[index].disponivel !== false);

        if (tipo === "loja") {
            localStorage.setItem("hubProdutosLoja", JSON.stringify(produtosLojaFisica));
            renderizarProdutosLojaFisica();
        } else {
            localStorage.setItem("hubProdutos", JSON.stringify(produtosPainel));
            renderizarProdutos();
        }
        atualizarDashboard();
    }

    function excluirProduto(index, tipo) {
        const arrayAlvo = tipo === "loja" ? produtosLojaFisica : produtosPainel;
        if (confirm(`Deseja excluir "${arrayAlvo[index].nome}"?`)) {
            arrayAlvo.splice(index, 1);
            if (tipo === "loja") {
                localStorage.setItem("hubProdutosLoja", JSON.stringify(produtosLojaFisica));
                renderizarProdutosLojaFisica();
            } else {
                localStorage.setItem("hubProdutos", JSON.stringify(produtosPainel));
                renderizarProdutos();
            }
            atualizarDashboard();
        }
    }

    function fecharModal() {
        document.getElementById("modalProduto").classList.remove("active");
        limparPreviaFoto();
    }

    function limparPreviaFoto() {
        novaImagemProduto = "";
        const preview = document.getElementById("produtoImagemPreview");
        preview.src = "";
        preview.style.display = "none";
        document.getElementById("produtoImagemArquivo").value = "";
    }

    function selecionarImagemProduto(e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(evt) {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement("canvas");
                const max = 600;
                let w = img.width, h = img.height;
                if (w > max || h > max) {
                    const ratio = Math.min(max / w, max / h);
                    w = Math.round(w * ratio);
                    h = Math.round(h * ratio);
                }
                canvas.width = w;
                canvas.height = h;
                canvas.getContext("2d").drawImage(img, 0, 0, w, h);
                novaImagemProduto = canvas.toDataURL("image/jpeg", 0.8);
                const preview = document.getElementById("produtoImagemPreview");
                preview.src = novaImagemProduto;
                preview.style.display = "block";
                document.getElementById("produtoImagem").value = "";
            };
            img.src = evt.target.result;
        };
        reader.readAsDataURL(file);
    }

    /* CONFIGURAÇÃO DO CARDÁPIO IMPRESSO */
    function carregarConfigImpresso() {
        const conf = JSON.parse(localStorage.getItem("hubImpressoConfig") || "{}");
        if (conf.modelo) document.getElementById("selectModeloImpresso").value = conf.modelo;
        if (conf.primaria) {
            document.getElementById("corImpressoPrimaria").value = conf.primaria;
            document.getElementById("corImpressoPrimariaHex").value = conf.primaria;
        }
        if (conf.secundaria) {
            document.getElementById("corImpressoSecundaria").value = conf.secundaria;
            document.getElementById("corImpressoSecundariaHex").value = conf.secundaria;
        }
        if (conf.fundo) {
            document.getElementById("corImpressoFundo").value = conf.fundo;
            document.getElementById("corImpressoFundoHex").value = conf.fundo;
        }
        if (conf.aviso) {
            document.getElementById("avisoImpresso").value = conf.aviso;
        }
    }

    function salvarConfigImpresso() {
        const conf = {
            modelo: document.getElementById("selectModeloImpresso").value,
            primaria: document.getElementById("corImpressoPrimariaHex").value,
            secundaria: document.getElementById("corImpressoSecundariaHex").value,
            fundo: document.getElementById("corImpressoFundoHex").value,
            aviso: document.getElementById("avisoImpresso").value.trim()
        };
        localStorage.setItem("hubImpressoConfig", JSON.stringify(conf));
        alert("Configurações do cardápio impresso salvas com sucesso!");
    }

    function abrirCardapioImpresso() {
        salvarConfigImpresso();
        window.open('teste.html', '_blank');
    }

    /* INTEGRAÇÕES COM O WHATSAPP */
    function obterNomeLoja() {
        const loja = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        return loja.nome || "Nossa Loja";
    }

    function gerarMensagemCardapio() {
        const nomeLoja = obterNomeLoja();
        const urlCardapio = window.location.origin; 
        return `👋 Olá! Seja bem-vindo(a) à *${nomeLoja}*.\n\n` +
               `🍽️ Confira nosso cardápio digital completo e faça seu pedido:\n` +
               `👉 ${urlCardapio}\n\n` +
               `Ficamos à disposição para montar o seu pedido!`;
    }

    function dispararLinkWhatsApp() {
        const msg = encodeURIComponent(gerarMensagemCardapio());
        window.open(`https://api.whatsapp.com/send?text=${msg}`, '_blank');
    }

    function copiarMensagemWhatsApp() {
        navigator.clipboard.writeText(gerarMensagemCardapio()).then(() => alert("Mensagem do cardápio copiada!"));
    }

    function gerarTextoDestaques() {
        const nomeLoja = obterNomeLoja();
        const destaques = produtosPainel.filter(p => p.destaque && p.disponivel !== false);

        if (destaques.length === 0) return null;

        let txt = `⭐ *Destaques de Hoje - ${nomeLoja}* ⭐\n\n`;
        destaques.forEach(item => {
            txt += `▪️ *${item.nome}* — R$ ${formatarPreco(item.preco)}\n`;
            if (item.descricao) txt += `   _${item.descricao}_\n`;
        });
        txt += `\n💬 Responda com o item desejado para confirmar seu pedido!`;
        return txt;
    }

    function dispararDestaquesWhatsApp() {
        const txt = gerarTextoDestaques();
        if (!txt) { alert("Nenhum item marcado como destaque no momento."); return; }
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(txt)}`, '_blank');
    }

    function copiarDestaquesWhatsApp() {
        const txt = gerarTextoDestaques();
        if (!txt) { alert("Nenhum item marcado como destaque no momento."); return; }
        navigator.clipboard.writeText(txt).then(() => alert("Destaques copiados para colar no WhatsApp!"));
    }

    function enviarProdutoIndividual(index) {
        const p = produtosPainel[index];
        const nomeLoja = obterNomeLoja();
        let txt = `🍽️ *${p.nome}* na *${nomeLoja}*\n\n`;
        if (p.descricao) txt += `📝 ${p.descricao}\n`;
        txt += `💰 *Valor:* R$ ${formatarPreco(p.preco)}\n\n`;
        txt += `Deseja que eu reserve ou prepare esse item para você?`;

        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(txt)}`, '_blank');
    }

    /* LOJA & HORÁRIOS */
    function salvarLoja() {
        const dados = {
            nome: document.getElementById("lojaNome").value.trim(),
            telefone: document.getElementById("lojaTelefone").value.trim(),
            whatsapp: document.getElementById("lojaWhatsapp").value.trim(),
            endereco: document.getElementById("lojaEndereco").value.trim(),
            bairro: document.getElementById("lojaBairro").value.trim(),
            cidade: document.getElementById("lojaCidade").value.trim(),
            estado: document.getElementById("lojaEstado").value.trim().toUpperCase(),
            cep: document.getElementById("lojaCep").value.trim(),
            descricao: document.getElementById("lojaDescricao").value.trim(),
            logo: window.logoLojaAtual || ""
        };

        if (!dados.nome) { alert("Informe o nome do seu estabelecimento."); return; }
        
        const lojaAntiga = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        const combinada = { ...lojaAntiga, ...dados };
        localStorage.setItem("hubLoja", JSON.stringify(combinada));
        
        atualizarVisualizacaoLoja(combinada);
        document.getElementById("dashboardNomeLoja").textContent = combinada.nome;
        alert("Dados da loja atualizados com sucesso!");
    }

    function carregarDadosLoja() {
        const salvo = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        if (salvo.nome) document.getElementById("lojaNome").value = salvo.nome;
        document.getElementById("lojaTelefone").value = salvo.telefone || "";
        document.getElementById("lojaWhatsapp").value = salvo.whatsapp || "";
        document.getElementById("lojaEndereco").value = salvo.endereco || "";
        document.getElementById("lojaBairro").value = salvo.bairro || "";
        document.getElementById("lojaCidade").value = salvo.cidade || "";
        document.getElementById("lojaEstado").value = salvo.estado || "";
        document.getElementById("lojaCep").value = salvo.cep || "";
        document.getElementById("lojaDescricao").value = salvo.descricao || "";
        window.logoLojaAtual = salvo.logo || "";
        atualizarVisualizacaoLoja(salvo);
    }

    function atualizarVisualizacaoLoja(dados) {
        document.getElementById("lojaPreviewNome").textContent = dados.nome || "Carioca Ice Cream";
        const enderecoPartes = [dados.endereco, dados.bairro, dados.cidade, dados.estado].filter(Boolean);
        document.getElementById("lojaPreviewEndereco").textContent = enderecoPartes.length ? enderecoPartes.join(" • ") : "Endereço não informado";
        if (dados.logo) {
            const imgPreview = document.getElementById("lojaPreviewLogoFinal");
            imgPreview.src = dados.logo;
            imgPreview.style.display = "block";
        }
    }

    /* CATEGORIAS & DASHBOARD */
    function renderizarCategorias() {
        const container = document.getElementById("listaCategorias");
        container.innerHTML = "";
        const categorias = [...new Set(produtosPainel.map(p => p.categoria).filter(Boolean))];

        if (categorias.length === 0) {
            container.innerHTML = `<div class="notice">Nenhuma categoria encontrada.</div>`;
            return;
        }

        categorias.forEach(cat => {
            const count = produtosPainel.filter(p => p.categoria === cat).length;
            const div = document.createElement("div");
            div.className = "category";
            div.innerHTML = `<strong>${cat}</strong><span>${count} produto(s)</span>`;
            container.appendChild(div);
        });
    }

    function atualizarDashboard() {
        document.getElementById("totalProdutos").textContent = produtosPainel.length;
        document.getElementById("totalProdutosLoja").textContent = produtosLojaFisica.length;
        document.getElementById("totalCategorias").textContent = new Set(produtosPainel.map(p => p.categoria).filter(Boolean)).size;
        document.getElementById("produtosAtivos").textContent = produtosPainel.filter(p => p.disponivel !== false).length;
        document.getElementById("totalDestaques").textContent = produtosPainel.filter(p => p.destaque).length;
    }

    /* REDES SOCIAIS */
    function carregarRedes() {
        const redes = JSON.parse(localStorage.getItem("hubRedes") || "{}");
        const loja = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        document.getElementById("instagram").value = redes.instagram || "";
        document.getElementById("facebook").value = redes.facebook || "";
        document.getElementById("tiktok").value = redes.tiktok || "";
        document.getElementById("whatsappRede").value = redes.whatsapp || loja.whatsapp || "";
        document.getElementById("googleAvaliacoes").value = redes.googleAvaliacoes || loja.googleAvaliacoes || "";
        document.getElementById("linkMapa").value = redes.linkMapa || loja.linkMapa || "";
    }

    function salvarRedes() {
        const redes = {
            instagram: document.getElementById("instagram").value.trim(),
            facebook: document.getElementById("facebook").value.trim(),
            tiktok: document.getElementById("tiktok").value.trim(),
            whatsapp: document.getElementById("whatsappRede").value.trim(),
            googleAvaliacoes: document.getElementById("googleAvaliacoes").value.trim(),
            linkMapa: document.getElementById("linkMapa").value.trim()
        };
        localStorage.setItem("hubRedes", JSON.stringify(redes));
        
        const loja = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        loja.whatsapp = redes.whatsapp;
        loja.googleAvaliacoes = redes.googleAvaliacoes;
        loja.linkMapa = redes.linkMapa;
        localStorage.setItem("hubLoja", JSON.stringify(loja));

        alert("Redes sociais salvas com sucesso!");
    }

    /* APARÊNCIA DIGITAL & SELEÇÃO SIMULTÂNEA DE LAYOUT */
    function aoTrocarModeloLayoutSimultaneo(modelo) {
        const aparencia = JSON.parse(localStorage.getItem("hubAparencia") || "{}");
        aparencia.modelo = modelo;
        localStorage.setItem("hubAparencia", JSON.stringify(aparencia));
    }

    function carregarAparencia() {
        const aparencia = JSON.parse(localStorage.getItem("hubAparencia") || "{}");
        
        if (aparencia.principal) {
            document.getElementById("aparenciaCorPrincipal").value = aparencia.principal;
            document.getElementById("aparenciaCorPrincipalHex").value = aparencia.principal;
        }
        if (aparencia.secundaria) {
            document.getElementById("aparenciaCorSecundaria").value = aparencia.secundaria;
            document.getElementById("aparenciaCorSecundariaHex").value = aparencia.secundaria;
        }
        if (aparencia.tema) {
            const radio = document.querySelector(`input[name="aparenciaTema"][value="${aparencia.tema}"]`);
            if (radio) radio.checked = true;
        }
        if (aparencia.estilo) {
            document.getElementById("aparenciaEstilo").value = aparencia.estilo;
        }

        const modeloSalvo = aparencia.modelo || "hub_classico";
        document.getElementById("selectModeloLayout").value = modeloSalvo;
        aplicarPreviewTema();
    }

    function salvarAparencia() {
        const aparenciaSalva = JSON.parse(localStorage.getItem("hubAparencia") || "{}");
        const dados = {
            ...aparenciaSalva,
            principal: document.getElementById("aparenciaCorPrincipalHex").value,
            secundaria: document.getElementById("aparenciaCorSecundariaHex").value,
            tema: document.querySelector('input[name="aparenciaTema"]:checked').value,
            estilo: document.getElementById("aparenciaEstilo").value,
            modelo: document.getElementById("selectModeloLayout").value
        };
        localStorage.setItem("hubAparencia", JSON.stringify(dados));
        aplicarPreviewTema();
        alert("Aparência digital salva com sucesso!");
    }

    function restaurarAparencia() {
        document.getElementById("aparenciaCorPrincipal").value = "#FFD400";
        document.getElementById("aparenciaCorPrincipalHex").value = "#FFD400";
        document.getElementById("aparenciaCorSecundaria").value = "#7B2CBF";
        document.getElementById("aparenciaCorSecundariaHex").value = "#7B2CBF";
        document.querySelector('input[name="aparenciaTema"][value="claro"]').checked = true;
        document.getElementById("aparenciaEstilo").value = "moderno";
        document.getElementById("selectModeloLayout").value = "hub_classico";
        aplicarPreviewTema();
        salvarAparencia();
    }

    function aplicarPreviewTema() {
        const box = document.getElementById("aparenciaPreview");
        const cp = document.getElementById("aparenciaCorPrincipal").value;
        const cs = document.getElementById("aparenciaCorSecundaria").value;
        const tema = document.querySelector('input[name="aparenciaTema"]:checked').value;
        
        box.style.setProperty("--preview-primary", cp);
        box.style.setProperty("--preview-secondary", cs);
        box.classList.toggle("dark", tema === "escuro");
    }

    /* CONFIGURAÇÕES, MÚSICA/WI-FI E BACKUP */
    function salvarConfigRecursosHub() {
        const loja = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        loja.exibirMusica = document.getElementById("checkExibirMusica").checked;
        loja.exibirWifi = document.getElementById("checkExibirWifi").checked;
        localStorage.setItem("hubLoja", JSON.stringify(loja));
    }

    function atualizarResumoConfiguracoes() {
        const p = JSON.parse(localStorage.getItem("hubProdutos") || "[]");
        document.getElementById("resumoProdutos").textContent = p.length;
        document.getElementById("resumoProdutosLoja").textContent = produtosLojaFisica.length;

        const cats = new Set(p.map(x => x.categoria).filter(Boolean));
        document.getElementById("resumoCategorias").textContent = cats.size;

        const redes = JSON.parse(localStorage.getItem("hubRedes") || "{}");
        document.getElementById("resumoRedes").textContent = (redes.whatsapp || redes.instagram) ? "Configuradas" : "Não configuradas";

        const loja = JSON.parse(localStorage.getItem("hubLoja") || "{}");
        document.getElementById("checkExibirMusica").checked = loja.exibirMusica !== false;
        document.getElementById("checkExibirWifi").checked = loja.exibirWifi !== false;
    }

    function exportarDados() {
        const backup = {
            produtos: produtosPainel,
            produtosLoja: produtosLojaFisica,
            telefoneCozinha: localStorage.getItem("hubTelefoneCozinha") || "",
            loja: JSON.parse(localStorage.getItem("hubLoja") || "{}"),
            redes: JSON.parse(localStorage.getItem("hubRedes") || "{}"),
            aparencia: JSON.parse(localStorage.getItem("hubAparencia") || "{}"),
            impresso: JSON.parse(localStorage.getItem("hubImpressoConfig") || "{}")
        };
        const blob = new Blob([JSON.stringify(backup, null, 2)], { type: "application/json" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `backup-hub-${Date.now()}.json`;
        a.click();
    }

    function importarDados(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const dados = JSON.parse(e.target.result);
                if (dados.produtos) localStorage.setItem("hubProdutos", JSON.stringify(dados.produtos));
                if (dados.produtosLoja) localStorage.setItem("hubProdutosLoja", JSON.stringify(dados.produtosLoja));
                if (dados.telefoneCozinha) localStorage.setItem("hubTelefoneCozinha", dados.telefoneCozinha);
                if (dados.loja) localStorage.setItem("hubLoja", JSON.stringify(dados.loja));
                if (dados.redes) localStorage.setItem("hubRedes", JSON.stringify(dados.redes));
                if (dados.aparencia) localStorage.setItem("hubAparencia", JSON.stringify(dados.aparencia));
                if (dados.impresso) localStorage.setItem("hubImpressoConfig", JSON.stringify(dados.impresso));
                alert("Dados restaurados com sucesso! Recarregando página...");
                location.reload();
            } catch (err) {
                alert("Arquivo de backup inválido.");
            }
        };
        reader.readAsDataURL(file);
    }

    function limparDados() {
        if (confirm("Atenção: todos os cadastros e imagens locais serão apagados. Deseja continuar?")) {
            localStorage.clear();
            location.reload();
        }
    }

    /* INICIALIZAÇÃO */
    document.addEventListener("DOMContentLoaded", () => {
        carregarDadosLoja();
        carregarRedes();
        atualizarDashboard();
        renderizarProdutos();
        renderizarCategorias();
        carregarAparencia();
        carregarConfigImpresso();
        atualizarResumoConfiguracoes();

        // Cores Aparência Digital
        const cp = document.getElementById("aparenciaCorPrincipal");
        const cpHex = document.getElementById("aparenciaCorPrincipalHex");
        const cs = document.getElementById("aparenciaCorSecundaria");
        const csHex = document.getElementById("aparenciaCorSecundariaHex");

        cp.addEventListener("input", () => { cpHex.value = cp.value.toUpperCase(); aplicarPreviewTema(); });
        cpHex.addEventListener("input", () => { cp.value = cpHex.value; aplicarPreviewTema(); });
        cs.addEventListener("input", () => { csHex.value = cs.value.toUpperCase(); aplicarPreviewTema(); });
        csHex.addEventListener("input", () => { cs.value = csHex.value; aplicarPreviewTema(); });
        document.querySelectorAll('input[name="aparenciaTema"]').forEach(r => r.addEventListener("change", aplicarPreviewTema));

        // Cores Impressão
        const cip = document.getElementById("corImpressoPrimaria");
        const cipHex = document.getElementById("corImpressoPrimariaHex");
        const cis = document.getElementById("corImpressoSecundaria");
        const cisHex = document.getElementById("corImpressoSecundariaHex");
        const cif = document.getElementById("corImpressoFundo");
        const cifHex = document.getElementById("corImpressoFundoHex");

        cip.addEventListener("input", () => cipHex.value = cip.value.toUpperCase());
        cipHex.addEventListener("input", () => cip.value = cipHex.value);
        cis.addEventListener("input", () => cisHex.value = cis.value.toUpperCase());
        cisHex.addEventListener("input", () => cis.value = cisHex.value);
        cif.addEventListener("input", () => cifHex.value = cif.value.toUpperCase());
        cifHex.addEventListener("input", () => cif.value = cifHex.value);
    });
</script>

